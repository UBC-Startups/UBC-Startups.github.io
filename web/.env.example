NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key used by the event registration RPC client. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Public app origin used to build the OAuth callback URL; must match the Supabase redirect allowlist.
APP_ORIGIN=http://127.0.0.1:3000
